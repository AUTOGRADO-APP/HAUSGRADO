# Copie para .env.local (nunca suba .env.local para o GitHub)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key
# Só no servidor (Vercel → Environment Variables, SEM o prefixo NEXT_PUBLIC). Nunca no código do navegador.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key
# Login por nome de usuário: o app converte "master" em "master@<domínio abaixo>"
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=usuarios.hausgrado.app
# Endereço público do site (usado no link do cliente)
NEXT_PUBLIC_SITE_URL=https://app.seudominio.com.br
